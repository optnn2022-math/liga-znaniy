/* v8.33 — practice questions: full-width text + table-style answers */
.practice-content .practice{
  width:100%;
  max-width:none;
  padding:24px 26px;
}
.practice-content .practice .visual-row{
  display:block;
  width:100%;
}
.practice-content .practice .visual-row > div,
.practice-content .practice > div{
  width:100%;
  max-width:none;
}
.practice-content .practice h3{
  width:100%;
  max-width:none;
  margin:0 0 12px;
  font-size:clamp(1.35rem,2vw,1.7rem);
  line-height:1.3;
}
.practice-content .practice p,
.practice-content .practice .muted,
.practice-content .practice .question{
  display:block;
  width:100%;
  max-width:none;
  margin:10px 0 18px;
  font-size:clamp(1.08rem,1.55vw,1.28rem);
  line-height:1.65;
  text-align:justify;
  text-justify:inter-word;
}
.practice-content .answers{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:12px;
  width:100%;
  margin-top:14px;
}
.practice-content .answer{
  display:flex;
  align-items:center;
  justify-content:center;
  width:100%;
  min-height:72px;
  padding:14px 18px;
  border-radius:12px;
  text-align:center;
  line-height:1.35;
  font-size:clamp(1.02rem,1.35vw,1.18rem);
}
.practice-content .mini{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:10px;
  width:100%;
}
.practice-content .chip{
  width:100%;
  min-height:56px;
  border-radius:12px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
}
@media(max-width:600px){
  .practice-content .practice{padding:18px 14px}
  .practice-content .answers{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .practice-content .answer{min-height:62px;padding:11px 8px;font-size:1rem}
  .practice-content .mini{grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
  .practice-content .practice p,
  .practice-content .practice .muted,
  .practice-content .practice .question{text-align:left;font-size:1.06rem;line-height:1.55}
}
