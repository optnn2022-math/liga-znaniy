/* v8.26 — readability + hero on stadium background */
:root{font-size:19px}
.page{max-width:1500px}
.page-title{font-size:clamp(2.5rem,4.6vw,4.2rem);line-height:1.05}
.muted{font-size:1.05rem}
.lesson-stage{display:grid;grid-template-columns:minmax(0,1050px) minmax(260px,380px);gap:30px;align-items:start}
.lesson-content{font-size:1.08rem;line-height:1.6}
.lesson-content h2{font-size:clamp(1.65rem,2.5vw,2.25rem);margin-top:30px;margin-bottom:12px}
.lesson-content h3{font-size:1.35rem}
.intro-coach{font-size:1.12rem;padding:18px 22px;margin:0 0 18px}
.steps span{font-size:1rem;padding:9px 15px}
.watch-list{font-size:1.08rem;line-height:1.65}
.theory>div,.practice{padding:21px}
.theory b{font-size:1.18rem}
.formula{font-size:1.4rem}
.answer,.chip,.textbtn,.cta{font-size:1.04rem}
.answer{min-height:64px;padding:14px 18px}
.practice input{font-size:1.05rem;padding:15px}
.hero-side{position:sticky;top:22px;align-self:start;background:transparent;padding-top:42px;text-align:center}
.lesson-player{width:100%;max-width:360px;max-height:520px;object-fit:contain;filter:drop-shadow(0 18px 28px #041735aa)}
.hero-tip{text-align:left;font-size:1rem;background:#0f4479e8}
@media(max-width:900px){
  :root{font-size:18px}
  .screen{padding-left:18px;padding-right:18px}
  .lesson-stage{grid-template-columns:minmax(0,1fr) 210px;gap:16px}
  .lesson-player{max-height:360px}
  .hero-tip{font-size:.92rem}
}
@media(max-width:680px){
  :root{font-size:17px}
  .page-title{font-size:2.25rem}
  .lesson-stage{grid-template-columns:minmax(0,1fr) 135px;gap:10px}
  .panel{padding:18px 16px}
  .hero-side{padding-top:70px}
  .lesson-player{max-height:260px}
  .hero-tip{display:none}
  .theory{grid-template-columns:1fr}
}

/* v8.27 — wider lesson workspace, matching the other Liga Znaniy lessons */
.page{max-width:1680px}
.lesson-stage{grid-template-columns:minmax(0,1250px) minmax(250px,340px);gap:26px}
.lesson-content{width:100%}
.video,.visual,.wordwall{max-width:none}
@media(max-width:900px){
  .screen{padding-left:12px;padding-right:12px}
  .page{margin-top:18px}
  .lesson-stage{grid-template-columns:minmax(0,1fr) 165px;gap:12px}
  .panel{padding:20px 18px}
  .hero-side{padding-top:48px}
  .lesson-player{max-height:330px}
}
@media(max-width:680px){
  .screen{padding:12px 6px 25px}
  .top,.page{width:100%;max-width:none}
  .lesson-stage{grid-template-columns:minmax(0,1fr) 118px;gap:6px}
  .panel{padding:18px 14px;border-radius:18px}
  .hero-side{padding-top:52px}
  .lesson-player{width:118px;max-height:245px}
  .lesson-content{font-size:1.08rem}
  .watch-list{padding-left:20px}
  .video{margin-left:0;margin-right:0}
}

/* v8.28 — wider task text + strict 16:9 video */
.lesson-content p,
.lesson-content .muted,
.lesson-content .watch-list li,
.lesson-content .question,
.lesson-content .feedback,
.lesson-content .coach{
  text-align:justify;
  text-justify:inter-word;
}
.practice,.theory>div{width:100%}
.practice>div,.visual-row>div{min-width:0;width:100%}
.video{
  width:100%;
  aspect-ratio:16 / 9;
  height:auto;
  max-height:none;
  overflow:hidden;
}
.video iframe{
  display:block;
  width:100%;
  height:100%;
  aspect-ratio:16 / 9;
  border:0;
}
@media(max-width:680px){
  .lesson-stage{grid-template-columns:minmax(0,1fr) 82px;gap:5px}
  .hero-side{padding-top:48px;overflow:visible}
  .lesson-player{width:92px;max-width:92px;max-height:190px;transform:translateX(-5px)}
  .panel{padding:18px 16px}
  .practice{padding:18px 16px}
  .practice p,.practice .muted,.question{width:100%;max-width:none}
  .answers{grid-template-columns:repeat(2,minmax(0,1fr));width:100%}
  .answer{width:100%;padding:13px 10px}
  .video{border-radius:14px}
}
@media(max-width:430px){
  .lesson-stage{grid-template-columns:minmax(0,1fr) 72px;gap:3px}
  .lesson-player{width:82px;max-width:82px;transform:translateX(-7px)}
  .panel{padding-left:14px;padding-right:14px}
}


/* v8.29 — 3/4 workspace + separate practice page */
.page{width:100%;max-width:1720px}
.lesson-stage{display:grid;grid-template-columns:minmax(0,3fr) minmax(180px,1fr);gap:24px;width:100%}
.lesson-content{min-width:0;width:100%}
.hero-side{min-width:0}
.lesson-next{margin-top:28px;padding:22px;border:1px solid #6da9d7;border-radius:18px;background:#0b376f}
.lesson-next p{max-width:none}
.practice-screen{position:fixed;inset:0;z-index:45;overflow:auto;background:linear-gradient(180deg,#05245599,#082852c9),url('../../../assets/embedded/img_001_67a145f6bf3e5227.png') center/cover fixed;padding:20px clamp(12px,3vw,48px) 36px}
.practice-page{max-width:1720px;margin:24px auto 0;display:grid;grid-template-columns:minmax(0,3fr) minmax(180px,1fr);gap:24px;align-items:start}
.practice-content{min-width:0;width:100%;font-size:1.08rem;line-height:1.6}
.practice-content h2{font-size:clamp(1.65rem,2.5vw,2.25rem)}
.practice-content h3{font-size:1.35rem}
.practice-content p,.practice-content .muted,.practice-content .question{text-align:justify;text-justify:inter-word;width:100%;max-width:none}
.practice-hero{position:sticky;top:22px;text-align:center;padding-top:30px}
.practice-hero img{width:100%;max-height:360px;object-fit:contain;filter:drop-shadow(0 12px 22px #051947)}
.practice-hero .coach{text-align:left}
@media(max-width:680px){
  .lesson-stage,.practice-page{grid-template-columns:minmax(0,3fr) minmax(82px,1fr);gap:6px}
  .lesson-player{width:100%;max-width:110px;transform:none}
  .practice-screen{padding:12px 6px 25px}
  .practice-content{padding:18px 14px}
  .practice-hero{padding-top:44px}
  .practice-hero img{width:100%;max-height:220px}
  .practice-hero .coach{display:none}
}
@media(max-width:430px){
  .lesson-stage,.practice-page{grid-template-columns:minmax(0,3fr) minmax(72px,1fr);gap:4px}
  .practice-content{padding-left:14px;padding-right:14px}
}

/* v8.30 — unified 16:9 media standard */
.wordwall{
  width:100%;
  max-width:none;
  aspect-ratio:16 / 9;
  margin:18px 0 12px;
  padding:0;
  overflow:hidden;
  border-radius:16px;
  background:#061f49;
}
.wordwall iframe{
  display:block;
  width:100%;
  height:100%;
  aspect-ratio:16 / 9;
  border:0;
  border-radius:0;
  background:#fff;
}
@media(max-width:820px){.wordwall iframe{height:100%}}
@media(max-width:600px){.wordwall iframe{height:100%}}

/* v8.31 — larger right-side main hero only; no other layout/mechanics changed */
.hero-side .lesson-player{
  width:118%;
  max-width:430px;
  max-height:620px;
  margin-left:-9%;
}
@media(max-width:900px){
  .hero-side .lesson-player{width:122%;max-width:245px;max-height:430px;margin-left:-11%}
}
@media(max-width:680px){
  .hero-side .lesson-player{width:132%;max-width:145px;max-height:300px;margin-left:-16%}
}
@media(max-width:430px){
  .hero-side .lesson-player{width:138%;max-width:125px;max-height:270px;margin-left:-19%}
}

